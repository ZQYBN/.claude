# 凭证与密钥
credentials.json
.env
*.key
*.pem

# 会话数据（含对话历史，隐私数据）
sessions/
session-env/
history.jsonl

# 运行时缓存
cache/
backups/
downloads/
paste-cache/
shell-snapshots/

# 遥测与状态（随会话变化，无复用价值）
telemetry/
file-history/
tasks/
teams/
plans/

# 项目状态（仅保留跨设备的 auto-memory 文件，会话转录等自动生成）
projects/*
!projects/*/
projects/*/**
!projects/*/memory/
!projects/*/memory/**

# 配置文件（含第三方 API key，使用模板替代）
settings.json

# 插件（Claude Code 自动维护，非用户管理内容）
plugins/

# 自引用（仓库内 .claude 目录为运行时生成，非配置内容）
.claude/

# 临时文件
*.tmp
*.log
.last-cleanup
claude-launcher.cmd
claude.reg
policy-limits.json
